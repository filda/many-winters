<Project>
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- Runs the IDE code-style rules as build analyzers too, so whatever .editorconfig sets
         to warning/error is enforced by `dotnet build` itself - notably IDE0055 (formatting),
         which makes a tab-indented or CRLF file fail the build here rather than only in CI's
         `dotnet format` step. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only for member ordering (SA1201-SA1204); every other StyleCop rule is switched off in
         .editorconfig. The 1.2 line is still labelled beta, but the last stable 1.1.118 predates
         C# 9 and does not know records. -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>
</Project>
