{
  "stryker-config": {
    "mutate": [
      "**/Continuity/BandName.cs",
      "**/Continuity/BandFate.cs",
      "**/Continuity/Grave.cs",
      "**/Continuity/GraveId.cs",
      "**/Continuity/Inscription.cs",
      "**/Continuity/NumberWords.cs"
    ],
    "reporters": ["html", "progress"],
    "concurrency": 2,
    "timeout-assembly": 30000,
    "timeout-tests": 60000,
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 95
    }
  }
}
