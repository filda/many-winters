<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ManyWinters.Build</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cake.Frosting" Version="6.3.0" />
    <!-- Windows-only, used by the Screenshot target to encode the captured window as PNG. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.31" />
  </ItemGroup>

</Project>
